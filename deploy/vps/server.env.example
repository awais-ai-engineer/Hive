# Copy this file to server.env and fill values from the existing production config.
# Do not commit server.env or paste its secrets into chat.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE?ssl=require
JWT_SECRET=existing-production-jwt-secret
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_KEY=existing-server-only-service-key
SUPABASE_BUCKET=hive-media

# Preserve existing OAuth behavior where configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional existing feature configuration; retain current production values when in use.
ANTHROPIC_API_KEY=
AI_PROVIDER=disabled
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
