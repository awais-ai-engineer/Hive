# Existing VPS hostname remains the API and Socket.IO endpoint.
PUBLIC_URL=https://hive.blackbox-n8n.duckdns.org
API_PUBLIC_URL=https://hive.blackbox-n8n.duckdns.org
# Vercel is the canonical browser origin; retain the existing site as an explicit
# rollback origin while it remains online.
WEB_ORIGIN=https://hive-connect.vercel.app
WEB_ORIGINS=https://hive.blackbox-n8n.duckdns.org

# Generate with: openssl rand -hex 32
REDIS_PASSWORD=replace-with-a-long-random-secret

# Applies only to the optional VPS-hosted frontend. Configure Vercel separately.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false
