# Canonical HTTPS URL for this VPS deployment. The provided VPS already resolves
# hive.blackbox-n8n.duckdns.org to its public IP.
PUBLIC_URL=https://hive.blackbox-n8n.duckdns.org

# Generate with: openssl rand -hex 32
REDIS_PASSWORD=replace-with-a-long-random-secret

# Set true if the existing Google OAuth client is configured for this URL.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false
